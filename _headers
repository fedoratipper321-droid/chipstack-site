# Cloudflare Pages cache rules: revalidate code, cache images long-term
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/css/*.css
  Cache-Control: public, max-age=0, must-revalidate
/js/*.js
  Cache-Control: public, max-age=0, must-revalidate
/img/*.webp
  Cache-Control: public, max-age=31536000, immutable
/app-ads.txt
  Cache-Control: public, max-age=0, must-revalidate
